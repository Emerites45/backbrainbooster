{
  "info": {
    "name": "BrainBooster — ASSIGNMENTS module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "taskId", "value": "1" },
    { "key": "userId", "value": "9" },
    { "key": "email", "value": "user.verify.1786448817@example.com" },
    { "key": "password", "value": "Secret123!" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('token', pm.response.json().token);", "pm.collectionVariables.set('userId', String(pm.response.json().id));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "GET assignees",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/assignees"
      }
    },
    {
      "name": "POST assign",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"primaryAssignee\": true\n}"
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/assignees"
      }
    },
    {
      "name": "DELETE unassign",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/assignees/{{userId}}"
      }
    }
  ]
}
