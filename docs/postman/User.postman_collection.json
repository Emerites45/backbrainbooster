{
  "info": {
    "name": "BrainBooster — USER module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "1" },
    { "key": "adminEmail", "value": "admin.users@example.com" },
    { "key": "adminPassword", "value": "Secret123!" }
  ],
  "item": [
    {
      "name": "0. Signup (puis SQL role=ADMIN + re-login)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Admin Users\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/signup"
      }
    },
    {
      "name": "0. Login ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "1. GET /users (ADMIN)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/users?page=0&size=20&activeOnly=true"
      }
    },
    {
      "name": "2. POST /users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId', String(pm.response.json().id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Member\",\n  \"email\": \"alice.member@example.com\",\n  \"password\": \"Secret123!\",\n  \"role\": \"USER\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users"
      }
    },
    {
      "name": "3. GET /users/{id}",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/users/{{userId}}"
      }
    },
    {
      "name": "4. PATCH /users/{id}",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Updated\",\n  \"role\": \"USER\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}"
      }
    },
    {
      "name": "5. PATCH /users/{id}/status INACTIVE",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}/status"
      }
    },
    {
      "name": "6. PATCH /users/{id}/status ACTIVE",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}/status"
      }
    },
    {
      "name": "7. GET /users sans ADMIN → 403",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/users"
      }
    }
  ]
}
