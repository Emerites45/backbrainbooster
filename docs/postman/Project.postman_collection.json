{
  "info": {
    "name": "BrainBooster — PROJECT module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "departmentId", "value": "1" },
    { "key": "projectId", "value": "1" },
    { "key": "email", "value": "user.verify.1786448817@example.com" },
    { "key": "password", "value": "Secret123!" }
  ],
  "item": [
    {
      "name": "Login ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "GET /departments (récupérer departmentId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "if (j.content && j.content.length) pm.collectionVariables.set('departmentId', String(j.content[0].id));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/departments?page=0&size=5"
      }
    },
    {
      "name": "POST /projects",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('projectId', String(pm.response.json().id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departmentId\": {{departmentId}},\n  \"name\": \"Projet Demo\",\n  \"description\": \"Créé via Postman\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects"
      }
    },
    {
      "name": "GET /projects?departmentId=",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/projects?departmentId={{departmentId}}&page=0&size=20"
      }
    },
    {
      "name": "GET /projects/{id}",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    },
    {
      "name": "PATCH /projects/{id}",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Projet Demo Updated\",\n  \"status\": \"ON_HOLD\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    },
    {
      "name": "GET /projects/{id}/tasks",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks?page=0&size=20"
      }
    },
    {
      "name": "DELETE /projects/{id}",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
      }
    }
  ]
}
