{
  "info": {
    "name": "BrainBooster — TASK module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "projectId", "value": "1" },
    { "key": "taskId", "value": "1" },
    { "key": "subtaskId", "value": "2" },
    { "key": "email", "value": "user.verify.1786448817@example.com" },
    { "key": "password", "value": "Secret123!" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "POST /tasks (root)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('taskId', String(pm.response.json().id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": {{projectId}},\n  \"title\": \"Tâche racine\",\n  \"description\": \"Root\",\n  \"priority\": \"HIGH\",\n  \"status\": \"TODO\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/tasks"
      }
    },
    {
      "name": "POST /tasks (subtask)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('subtaskId', String(pm.response.json().id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": {{projectId}},\n  \"parentTaskId\": {{taskId}},\n  \"title\": \"Sous-tâche\",\n  \"priority\": \"MEDIUM\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/tasks"
      }
    },
    {
      "name": "GET /tasks?projectId=",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/tasks?projectId={{projectId}}&page=0&size=20"
      }
    },
    {
      "name": "GET /tasks/{id}",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    },
    {
      "name": "PATCH /tasks/{id}/status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/status"
      }
    },
    {
      "name": "PATCH /tasks/{id}",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tâche racine updated\",\n  \"priority\": \"CRITICAL\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    },
    {
      "name": "DELETE /tasks/{id}",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      }
    }
  ]
}
