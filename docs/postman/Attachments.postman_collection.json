{
  "info": {
    "name": "BrainBooster — ATTACHMENTS module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "taskId", "value": "1" },
    { "key": "attachmentId", "value": "1" },
    { "key": "email", "value": "user.verify.1786448817@example.com" },
    { "key": "password", "value": "Secret123!" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "GET attachments",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/attachments?page=0&size=20"
      }
    },
    {
      "name": "POST upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.collectionVariables.set('attachmentId', String(pm.response.json().id));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/attachments"
      }
    },
    {
      "name": "DELETE attachment",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/attachments/{{attachmentId}}"
      }
    }
  ]
}
